# Server
APP_ENV=development
APP_PORT=8080

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB=project1_web

# JWT
JWT_SECRET=please-change-me-in-production-this-is-just-a-demo-secret-key
JWT_EXPIRES_HOURS=24

# CORS — origin của FE (Vite mặc định 5173)
CORS_ALLOWED_ORIGIN=http://localhost:5173

# Cloudinary — lấy từ https://console.cloudinary.com/settings
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
