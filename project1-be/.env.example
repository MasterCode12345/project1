# Server
APP_ENV=development
APP_PORT=8080

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB=project1_web

# JWT
JWT_SECRET=please-change-me-in-production-this-is-just-a-demo-secret-key
JWT_EXPIRES_HOURS=24

# CORS — origin của FE (Vite mặc định 5173)
CORS_ALLOWED_ORIGIN=http://localhost:5173

# Cloudinary — lấy từ https://console.cloudinary.com/settings
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# SMTP — gửi email xác minh tài khoản
# Gmail: dùng App Password (https://myaccount.google.com/apppasswords)
APP_URL=http://localhost:5173
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=no-reply@unimarket.vn

# VNPay — đăng ký tại https://sandbox.vnpayment.vn/devreg
VNPAY_TMN_CODE=your_tmn_code
VNPAY_HASH_SECRET=your_hash_secret
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_RETURN_URL=http://localhost:5173/payment/vnpay/return
VNPAY_DEBUG=false
